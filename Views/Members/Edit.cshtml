@model LibraryMember
@{ ViewData["Title"] = "Tag szerkesztése"; }

<div class="page-header">
    <h1>Tag szerkesztése</h1>
    <a asp-action="Index" class="btn btn-outline">← Vissza</a>
</div>

<div class="section-card form-card">
    <div class="alert alert-info">
        ℹ A tag típusa nem módosítható. Típus: <strong>@Model.MemberTypeDisplay</strong>
    </div>
    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-grid">
            <div class="form-group">
                <label>Név *</label>
                <input type="text" name="name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Lakcím *</label>
                <input type="text" name="address" value="@Model.Address" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Elérhetőség</label>
                <input type="text" name="contact" value="@Model.Contact" class="form-control" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Módosítás mentése</button>
            <a asp-action="Index" class="btn btn-outline">Mégse</a>
        </div>
    </form>
</div>
