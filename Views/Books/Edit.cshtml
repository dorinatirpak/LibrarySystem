@model Book
@{ ViewData["Title"] = "Könyv szerkesztése"; }

<div class="page-header">
    <h1>Könyv szerkesztése</h1>
    <a asp-action="Index" class="btn btn-outline">← Vissza</a>
</div>

<div class="section-card form-card">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="IsDeleted" type="hidden" />
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Author">Szerző *</label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title">Cím *</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Publisher">Kiadó</label>
                <input asp-for="Publisher" class="form-control" />
                <span asp-validation-for="Publisher" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Year">Kiadási év</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Edition">Kiadás</label>
                <input asp-for="Edition" class="form-control" />
                <span asp-validation-for="Edition" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ISBN">ISBN *</label>
                <input asp-for="ISBN" class="form-control" />
                <span asp-validation-for="ISBN" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="CopyCount">Példányszám</label>
                <input asp-for="CopyCount" type="number" class="form-control" />
                <span asp-validation-for="CopyCount" class="field-validation-error"></span>
            </div>
            <div class="form-group form-group--checkbox">
                <label>
                    <input asp-for="IsLoanable" type="checkbox" />
                    Kölcsönözhető
                </label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Módosítás mentése</button>
            <a asp-action="Index" class="btn btn-outline">Mégse</a>
        </div>
    </form>
</div>

