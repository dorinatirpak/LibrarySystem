@model Book
@{ ViewData["Title"] = "Könyv szerkesztése"; }

<div class="page-header">
    <h1>Könyv szerkesztése</h1>
    <a asp-action="Index" class="btn btn-outline">← Vissza</a>
</div>

<div class="section-card form-card">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="IsDeleted" type="hidden" />
        <div class="form-grid">
            <div class="form-group">
                <label>Szerző *</label>
                <input asp-for="Author" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Cím *</label>
                <input asp-for="Title" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Kiadó</label>
                <input asp-for="Publisher" class="form-control" />
            </div>
            <div class="form-group">
                <label>Kiadási év</label>
                <input asp-for="Year" type="number" class="form-control" min="1000" max="2100" />
            </div>
            <div class="form-group">
                <label>Kiadás</label>
                <input asp-for="Edition" class="form-control" />
            </div>
            <div class="form-group">
                <label>ISBN</label>
                <input asp-for="ISBN" class="form-control" />
            </div>
            <div class="form-group">
                <label>Példányszám</label>
                <input asp-for="CopyCount" type="number" class="form-control" min="0" />
            </div>
            <div class="form-group form-group--checkbox">
                <label>
                    <input asp-for="IsLoanable" type="checkbox" />
                    Kölcsönözhető
                </label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Módosítás mentése</button>
            <a asp-action="Index" class="btn btn-outline">Mégse</a>
        </div>
    </form>
</div>

