@model EditMemberViewModel
@{ ViewData["Title"] = "Tag szerkesztése"; }

<div class="page-header">
    <h1>Tag szerkesztése</h1>
    <a asp-action="Index" class="btn btn-outline">← Vissza</a>
</div>

<div class="section-card form-card">
    <div class="alert alert-info">
         A tag típusa nem módosítható. Típus: <strong>@Model.MemberTypeDisplay</strong>
    </div>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name">Név *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address">Lakcím *</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Contact">E-mail cím *</label>
                <input asp-for="Contact" class="form-control" placeholder="pelda@email.hu" />
                <span asp-validation-for="Contact" class="field-validation-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Módosítás mentése</button>
            <a asp-action="Index" class="btn btn-outline">Mégse</a>
        </div>
    </form>
</div>

