@model LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Bejelentkezés – Könyvtári Rendszer</title>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css?v=@(DateTime.Now.Ticks)"/>
    <style>

        .password-wrapper {
            position: relative !important;
            display: block !important;
            width: 100% !important;
        }
        .password-toggle {
            position: absolute !important;
            right: 8px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            background: transparent !important;
            background-color: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 8px !important;
            margin: 0 !important;
            line-height: 0 !important;
            z-index: 10 !important;
            cursor: pointer !important;
            outline: none !important;
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
        }
        .password-toggle:hover {
            background: rgba(255,255,255,0.05) !important;
        }
        input::-ms-reveal, input::-ms-clear {
            display: none !important;
        }
    </style>
</head>
<body class="login-body">
<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
            </div>
            <h1>Könyvtári Rendszer</h1>
            <p>Kérem, jelentkezzen be a folytatáshoz</p>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <form method="post" autocomplete="off">
            <div class="form-group">
                <label for="Username">Felhasználónév</label>
                <input type="text" id="Username" name="Username" class="form-control"
                       placeholder="admin" autofocus autocomplete="off" required />
            </div>
            <div class="form-group">
                <label for="Password">Jelszó</label>
                <div class="password-wrapper">
                    <input type="password" id="Password" name="Password" class="form-control"
                           placeholder="••••••••" autocomplete="new-password" required style="padding-right: 45px !important; width: 100% !important;" />
                    <button type="button" class="password-toggle" id="togglePassword" title="Jelszó megjelenítése">
                        <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            @if (Model.FailedAttempts > 0)
            {
                <p class="attempts-warning">
                    Hátralévő próbálkozások: @(3 - Model.FailedAttempts)
                </p>
            }

            <button type="submit" class="btn btn-primary btn-full">Bejelentkezés</button>
        </form>
    </div>
</div>

<script>
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#Password');
    const eyeIcon = document.querySelector('#eyeIcon');

    togglePassword.addEventListener('click', function (e) {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        
        if (type === 'text') {
            this.style.opacity = '1';
            this.style.color = 'var(--accent)';
            eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
        } else {
            this.style.opacity = '0.6';
            this.style.color = 'var(--text-dim)';
            eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
        }
    });
</script>
</body>
</html>
